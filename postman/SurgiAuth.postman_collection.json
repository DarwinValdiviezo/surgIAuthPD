        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Respuesta JSON valida\", function () {",
                  "  pm.response.to.be.json;",
                  "});",
                  "",
                  "const data = pm.response.json();",
                  "",
                  "pm.test(\"Incluye banderas de configuracion\", function () {",
                  "  pm.expect(data).to.have.property(\"config\");",
                  "  pm.expect(data.config).to.have.property(\"hasToken\");",
                  "  pm.expect(data.config).to.have.property(\"hasCasesDataSource\");",
                  "  pm.expect(data.config).to.have.property(\"hasPoliciesDataSource\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notion/health",
